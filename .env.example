# Devin API key – obtain from https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=your_devin_api_key_here

# GitHub personal access token (needs repo scope for issue comments)
GITHUB_TOKEN=your_github_token_here

# Optional: shared secret for GitHub webhook signature verification
WEBHOOK_SECRET=

# Optional: polling interval in seconds (default 30)
POLL_INTERVAL=30
